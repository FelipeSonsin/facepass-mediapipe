# Copie este arquivo para .env e reinicie o servidor após editar.
# O reconhecimento facial funciona sem APIs externas ou chaves.
FACEPASS_PORT=3000
FACEPASS_DEV_PORT=5173
FACEPASS_PREVIEW_PORT=4173
FACEPASS_DB_FILE=backend/data/banco.json

# Opcionais: reservadas para uma futura integração no back-end.
# Preencher estes campos não ativa um provedor automaticamente.
# Nunca coloque segredos em variáveis VITE_, que podem ir ao navegador.
EXTERNAL_API_URL=
EXTERNAL_API_KEY=
